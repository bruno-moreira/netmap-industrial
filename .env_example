# Configurações de Portas e Ambiente — NetMap Industrial

# Porta de Acesso do Sistema em Produção (Gateway Nginx)
SYSTEM_PORT=8082

# Rota de API do Frontend (em produção deve ser a rota relativa /api)
VITE_API_URL=/api

# Portas Internas
PORT=3002
DB_PORT=5434
VITE_PORT=5173

NODE_ENV=production
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=netmap
LOG_LEVEL=info
CORS_ORIGIN=*
