{
  "name": "netmap-industrial-api",
  "version": "1.0.0",
  "description": "API de mapeamento de rede industrial - NetMap Industrial",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:list",
    "seed:run": "knex seed:run",
    "seed:many": "node scripts/seedMany.js",
    "test": "node --test --test-reporter spec src/**/*.test.js src/integration/**/*.test.js",
    "test:unit": "node --test --test-reporter spec src/utils src/schemas src/middlewares src/services",
    "test:integration": "node --test --test-reporter spec src/integration",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": ["network", "switch", "vlan", "industrial"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "knex": "^3.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
